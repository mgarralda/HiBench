include README.md LICENSE NOTICE CITATION.cff pyproject.toml pom.xml
recursive-include hibench *.py
recursive-include conf *.conf *.info *.lst
recursive-include sparkbench/common/src/main/resources *
recursive-include sparkbench/sql/src/main/resources *
recursive-include sparkbench/graph/src/main/resources *
recursive-include bin *.py *.sh *.ps1 *.html
recursive-include sparkbench *.java *.scala *.xml nweight-user-features
recursive-include tests *.py *.json *.yaml *.java *.scala *.conf *.info *.md
prune report
prune docs
prune docs_internal
global-exclude __pycache__ *.pyc *.class *.jar
recursive-include deployment *.yml *.md *.py Dockerfile .env.example
recursive-include conf *.license
recursive-include sparkbench *.license
recursive-include tests *.license
include LICENSE.coverage.json LICENSE.coverage.json.license .dockerignore

recursive-include hibench/ui/assets *.png *.ico *.license

include .streamlit/config.toml
