# Generate without local Python: docker run --rm python:3.11-slim python -c "import secrets; print(secrets.token_urlsafe(32))"
HIBENCH_API_TOKEN=replace-with-a-generated-token
HIBENCH_API_PORT=8000
HIBENCH_UI_PORT=8501

# Optional SSH defaults, used only when choosing the SSH adapter.
# From this controller container, use the Docker host's reachable address.
HIBENCH_SSH_HOST=host.docker.internal
HIBENCH_SSH_USERNAME=sparker
HIBENCH_SSH_PORT=2222
# Paths INSIDE the controller. Mount existing authorized files read-only using a local Compose override.
HIBENCH_SSH_IDENTITY_FILE=
HIBENCH_SSH_KNOWN_HOSTS_FILE=

# Optional password authentication. Keep secrets in ignored .env or exported environment, never experiment files.
# An explicit identity_file takes precedence. Server host keys must still be verified.
HIBENCH_SSH_PASSWORD=
